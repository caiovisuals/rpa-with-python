# Copie para .env e preencha. O .env NUNCA é versionado.
# O compose falha se POSTGRES_PASSWORD não estiver definida — de propósito:
# melhor não subir do que subir com senha conhecida.

APP_ENV=development

# --- banco de desenvolvimento ---------------------------------------------
POSTGRES_USER=rpa
POSTGRES_DB=rpa
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- pendentes das fases seguintes -----------------------------------------
# DATABASE_URL é montada pelo compose a partir das variáveis acima.
# SECRET_KEY=                    # Fase 5 (autenticação)
# BANK_DATA_ENCRYPTION_KEY=      # Fase 8 (criptografia de dados bancários)
